; Official xinput1_3 ordinals (also match 1_4/1_2/1_1 for 2-5,7,8). UE5 games etc. import BY ORDINAL
; (2=GetState, 3=SetState); without a .def zig assigns alphabetical ordinals -> wrong function -> crash.
LIBRARY xinput1_3
EXPORTS
    XInputGetState @2
    XInputSetState @3
    XInputGetCapabilities @4
    XInputEnable @5
    XInputGetDSoundAudioDeviceGuids @6
    XInputGetBatteryInformation @7
    XInputGetKeystroke @8
    XInputGetStateEx @100 NONAME
